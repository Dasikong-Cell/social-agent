/* ========== 全局 ========== */
.page {
  min-height: 100vh;
  background: #F2F4FB;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

/* ========== Hero 顶部 ========== */
.hero {
  position: relative;
  padding: 60rpx 40rpx 80rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, #4F7CFF 0%, #7B61FF 50%, #9B59FF 100%);
}

.hero-bg::after {
  content: '';
  position: absolute;
  width: 400rpx; height: 400rpx;
  top: -150rpx; right: -100rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 50%;
}

.hero-bg::before {
  content: '';
  position: absolute;
  width: 250rpx; height: 250rpx;
  bottom: -80rpx; left: -60rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 50%;
}

.hero-content {
  position: relative;
  z-index: 2;
}

.hero-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.hero-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.75);
  margin-top: 8rpx;
}

.hero-badge {
  position: absolute;
  top: 60rpx; right: 40rpx;
  z-index: 2;
  background: rgba(255,255,255,0.2);
  backdrop-filter: blur(10px);
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  text-align: center;
  border: 1rpx solid rgba(255,255,255,0.3);
}

.badge-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.badge-label {
  display: block;
  font-size: 20rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 6rpx;
}

/* ========== 卡片通用 ========== */
.card {
  background: #fff;
  border-radius: 24rpx;
  margin: -40rpx 28rpx 24rpx;
  padding: 28rpx 28rpx 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(79,124,255,0.08);
  position: relative;
  z-index: 3;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.card-clear {
  font-size: 24rpx;
  color: #8A8FAE;
  padding: 6rpx 16rpx;
  background: #F2F4FB;
  border-radius: 20rpx;
}

.card-clear:active {
  background: #E5E8F3;
}

/* ========== 配置参数 ========== */
.cfg-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F2F4FB;
}

.cfg-row:last-child {
  border-bottom: none;
}

.cfg-label {
  font-size: 26rpx;
  color: #5A5F7A;
  font-weight: 500;
}

.cfg-pill {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #F0F3FF, #EAE7FF);
  border-radius: 16rpx;
  padding: 12rpx 24rpx;
}

.cfg-pill-text {
  font-size: 26rpx;
  color: #4F7CFF;
  font-weight: 600;
}

.cfg-pill-arrow {
  font-size: 24rpx;
  color: #9B8CFF;
  margin-left: 12rpx;
}

/* ========== 输入区 ========== */
.input-area {
  width: 100%;
  min-height: 160rpx;
  background: #F7F8FD;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #1a1a2e;
  line-height: 1.6;
  box-sizing: border-box;
}

.input-ph {
  color: #B5BACF;
  font-size: 26rpx;
}

/* ========== 生成按钮 ========== */
.btn-gen-wrap {
  padding: 16rpx 28rpx 28rpx;
}

.btn-gen {
  background: linear-gradient(135deg, #4F7CFF 0%, #7B61FF 100%);
  border-radius: 48rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(79,124,255,0.35);
  transition: transform 0.15s, box-shadow 0.15s;
}

.btn-gen:active {
  transform: scale(0.98);
  box-shadow: 0 6rpx 16rpx rgba(79,124,255,0.25);
}

.btn-gen.loading {
  opacity: 0.7;
}

.btn-gen-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 2rpx;
}

.btn-gen-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid rgba(255,255,255,0.3);
  border-top-color: #fff;
  border-radius: 50%;
  margin-right: 16rpx;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ========== 结果区 ========== */
.result-card {
  border-left: 6rpx solid #7B61FF;
}

.result-count {
  font-size: 22rpx;
  color: #B5BACF;
}

.result-text {
  font-size: 30rpx;
  color: #1a1a2e;
  line-height: 1.85;
  padding: 8rpx 0 24rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

.action-row {
  display: flex;
  justify-content: space-around;
  border-top: 1rpx solid #F2F4FB;
  padding-top: 24rpx;
  margin-top: 8rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  transition: background 0.15s;
}

.action-btn:active {
  background: #F7F8FD;
}

.action-icon {
  font-size: 40rpx;
  margin-bottom: 6rpx;
}

.action-label {
  font-size: 22rpx;
  color: #5A5F7A;
  font-weight: 500;
}

/* ========== 历史记录 ========== */
.history-list {
  padding-top: 8rpx;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 22rpx 16rpx;
  background: #F7F8FD;
  border-radius: 16rpx;
  margin-bottom: 14rpx;
  transition: background 0.15s;
}

.history-item:active {
  background: #ECEEF7;
}

.history-text {
  flex: 1;
  font-size: 26rpx;
  color: #3A3F5A;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.5;
}

.history-arrow {
  font-size: 36rpx;
  color: #B5BACF;
  margin-left: 12rpx;
}

.bottom-space {
  height: 80rpx;
}
