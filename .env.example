# ===== social-agent 环境变量示例 =====
# 复制为 .env 后填写；.env 已被 .gitignore 忽略

# QQ 机器人凭证
QQ_APPID=
QQ_BOT_SECRET=
QQ_API=

# 大模型 API Key（按 deepseek_agent.py 配置二选一或都填）
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# 服务监听
SERVER_PORT=8000
# 绑定地址：默认 127.0.0.1（仅本机）；暴露到局域网/公网请设 0.0.0.0 并务必配置 SERVER_API_KEY
BIND_HOST=127.0.0.1
# 服务端 API Key：留空=不强制；一旦设置，/api/send_qq 与 /api/task 必须带 X-API-Key 头
SERVER_API_KEY=

# 大模型供应商与模型（deepseek_agent.py）
AI_PROVIDER=dashscope
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# QQ 推送目标频道（QQ_APPID/QQ_BOT_SECRET 已在上方）
QQ_TARGET_CHANNEL_ID=
